{
    "name": "avangard/api",
    "description": "AVANGARD API v4 client for php",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Maxim Bykovskiy",
            "email": "BykovskiyM@avangard.ru"
        },
        {
            "name": "Aleksander Ignatev",
            "email": "ignateva@avangard.ru"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": ">=5.6.0",
        "ext-json": "*",
        "ext-dom": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^6.4",
        "psr/log": "^1.0.2",
        "psr/http-message": "1.0.1 as 1.0",
        "symfony/polyfill-intl-idn": "1.19.0 as 1.17",
        "symfony/polyfill-intl-normalizer": "1.19.0 as 1.10",
        "symfony/polyfill-php70": "1.19.0 as 1.10",
        "symfony/polyfill-php72": "1.19.0 as 1.10",
        "paragonie/random_compat": "2.0.21 as 9.99"
    },
    "config": {
        "preferred-install": "dist"
    },
    "autoload": {
        "psr-4": {
            "Avangard\\": "src/"
        }
    },
}
